# ==============================================================================
# SCOTA ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env.local dan sesuaikan nilai konfigurasinya.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Self-hosted VPS / Neon / Docker)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@hostname:5432/scota_db"

# ------------------------------------------------------------------------------
# 2. AI OCR ENGINE (Google Gemini Cloud Vision API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-google-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. INTERNAL SECURITY & SUPERADMIN MASTER ACCESS
# ------------------------------------------------------------------------------
# Generate dengan: openssl rand -base64 48
SESSION_SECRET="your-strong-random-session-secret-at-least-32-chars"
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD="your-superadmin-password"
NEXT_PUBLIC_SUPERADMIN_EMAIL="admin@yourdomain.com"

# ------------------------------------------------------------------------------
# 4. CLERK AUTHENTICATION & ROUTING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key"
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your-webhook-signing-secret"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ------------------------------------------------------------------------------
# 5. PLATFORM CONTACT & SUPPORT (WhatsApp)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_WHATSAPP="6281234567890"

# ------------------------------------------------------------------------------
# 6. PUBLIC APP & BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://scota.web.id"

# ------------------------------------------------------------------------------
# 7. PAKASIR PAYMENT GATEWAY (https://app.pakasir.com)
# ------------------------------------------------------------------------------
PAKASIR_PROJECT_SLUG="scota"
PAKASIR_API_KEY="your-pakasir-api-key"
PAKASIR_BASE_URL="https://app.pakasir.com"

# ------------------------------------------------------------------------------
# 8. OPTIONAL: SMTP EMAIL NOTIFICATIONS (Gmail / Resend / Sendgrid)
# Jika tidak diisi, kode verifikasi OTP akan dicetak ke log server/terminal.
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="\"SCOTA Platform\" <no-reply@yourdomain.com>"

