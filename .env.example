# PostgreSQL Database Connection (Sumopod, Self-hosted VPS, Neon, Railway, Docker)
DATABASE_URL="postgresql://username:password@hostname:5432/scota_db"

# Optional: Direct connection URL or SSL Pooler
# POSTGRES_URL="postgresql://username:password@hostname:5432/scota_db"

# Google Gemini AI Vision API Key
GEMINI_API_KEY="your-gemini-api-key"

# JWT Session Secret (Cryptographic Signature)
SESSION_SECRET="your-cryptographic-session-secret-key"

# Superadmin / Developer Master Credentials (Single Platform Owner)
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD="your-superadmin-password"

# Default Tenant Admin & Staff Fallback
ADMIN_A_USERNAME="admin"
ADMIN_A_PASSWORD="your-admin-password"

ADMIN_B_USERNAME="admin2"
ADMIN_B_PASSWORD="your-admin2-password"

# Karyawan Authentication Credentials
KARYAWAN_USERNAME="karyawan"
KARYAWAN_PASSWORD="your-karyawan-password"

# Platform Support & Sales Contact (Dynamic WhatsApp)
NEXT_PUBLIC_SUPPORT_WHATSAPP="6285215973776"
