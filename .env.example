# PostgreSQL Database Connection (Sumopod, Self-hosted VPS, Neon, Railway, Docker)
DATABASE_URL="postgresql://username:password@hostname:5432/scota_db"

# Optional: Direct connection URL or SSL Pooler
# POSTGRES_URL="postgresql://username:password@hostname:5432/scota_db"

# Google Gemini AI Vision API Key
GEMINI_API_KEY="your-gemini-api-key"

# JWT Session Secret (Cryptographic Signature) - WAJIB DIISI!
# Tidak ada nilai default fallback di kode sumber demi mencegah pemalsuan token.
# Generate dengan: openssl rand -base64 48 atau node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="generate-a-strong-random-secret-key-at-least-32-characters-long"

# Superadmin / Developer Master Credentials (Single Platform Owner)
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD="your-superadmin-password"

# Platform Support & Sales Contact (Dynamic WhatsApp)
NEXT_PUBLIC_SUPPORT_WHATSAPP="6285215973776"

# Email Verification & Notifications (SMTP - Gmail, Resend, Sendgrid, etc.)
# Jika tidak diisi di dev mode, OTP verification akan dicetak langsung ke console/terminal.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="\"SCOTA Platform\" <no-reply@yourdomain.com>"

# Clerk Authentication & Routing Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key"
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your-webhook-signing-secret"
NEXT_PUBLIC_SUPERADMIN_EMAIL="refo.gangga@gmail.com"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
